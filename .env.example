# Template for the .env file that install.sh generates on first run — the
# secrets below are generated automatically, you shouldn't need to touch
# this file by hand. Kept here so the required variables are documented in
# one place. For manual setup: cp .env.example .env, fill in the values,
# then docker compose up -d --build.

# --- Filled in by install.sh ---
# A domain (e.g. vpn.example.com) gets public ACME certificates; a public
# IPv4 address also works (HTTPS then uses Caddy's internal self-signed CA).
CONSOLE_DOMAIN=
WG_PUBLIC_ENDPOINT=
APP_ENCRYPTION_KEY=
SESSION_SIGNING_KEY=
POSTGRES_PASSWORD=
ADGUARD_API_PASSWORD=
# AdGuard Home login user for the /control API (Basic auth); defaults to
# "admin" when unset.
ADGUARD_API_USER=admin

# Console origin for CORS. Defaults to https://<CONSOLE_DOMAIN> when unset.
# The SPA and API are same-origin behind Caddy; this only matters if a
# cross-origin client is ever configured.
# CONSOLE_ORIGIN=

# --- Optional: session lifecycle ---
# Sessions idle longer than this are rejected (Profile → Active Sessions
# shows live sessions). Minutes; 0 disables the idle check (absolute 24h
# expiry only).
SESSION_IDLE_MINUTES=30

# --- First super_admin bootstrap (used only on a fresh database) ---
# install.sh prompts for the admin email interactively (default
# admin@company.com) and auto-generates the password, printing both in its
# summary output. Pre-set ADMIN_EMAIL / ADMIN_PASSWORD to skip the prompt
# and choose your own credentials; the API creates the account from these
# values on the first boot of an empty database. Re-running install.sh on
# an existing install keeps the current values and never reseeds — unless
# the Postgres data volume is gone (a reset), in which case it re-prompts
# and prints fresh credentials.
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=

# TLS mode for Caddy. Empty = domain mode (public ACME certificates).
#   - "internal"      → IP-only deployments (no domain): Caddy uses its
#                       internal self-signed CA for HTTPS.
#   - "external-proxy" → the console is fronted by Cloudflare (or another
#                       TLS-terminating proxy) in Flexible / "Automatic
#                       SSL/TLS" mode, where the proxy reaches this server
#                       over PLAIN HTTP. Caddy then serves plain HTTP only
#                       (no TLS, no HTTP→HTTPS redirect) — this fixes the
#                       ERR_TOO_MANY_REDIRECTS loop that happens when Caddy
#                       keeps redirecting the proxy's plain-HTTP requests
#                       to https. The console is NOT served on :443 in this
#                       mode (only the AdGuard block page is, for direct
#                       clients) — Cloudflare must use the HTTP origin.
#                       Use the empty value if the proxy can reach an HTTPS
#                       origin (Cloudflare "Full").
WGCONSOLE_TLS=

# --- Optional: SMTP for user/admin invite emails ---
# Configurable later from Configuration → Email in the console itself;
# these are just the bootstrap defaults if you'd rather set them up front.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Optional: Web-activity retention ---
# How long per-peer DNS browsing records (imported from AdGuard Home's query
# log) are kept before the worker purges them. Applies to the nightly
# auto-purge and to the Web Activity page's housekeeping presets. Defaults to
# 30 days when unset.
BROWSE_RETENTION_DAYS=30
