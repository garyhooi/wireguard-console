# Canonical production origin. Required before a production build so
# canonical URLs, sitemap entries and social image URLs are correct.
NEXT_PUBLIC_SITE_URL=https://wireguard-console.g-studio.dev

# Set to "export" for a static Cloudflare Pages build, or "standalone" for Docker.
NEXT_OUTPUT=

# Optional: link to a real console from the interactive demo top bar.
NEXT_PUBLIC_CONSOLE_URL=

# Optional: Google Search Console HTML verification token.
GOOGLE_SITE_VERIFICATION=