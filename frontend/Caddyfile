# WGCONSOLE_TLS: leave empty for domain names (public ACME certificates,
# the default). For IP-only deployments (no domain), install.sh sets it to
# "tls internal" so Caddy serves HTTPS with its internal CA — public
# certificate authorities cannot issue certificates for bare IPs.
{$CONSOLE_DOMAIN} {
	# Expands to "tls internal" for IP-only deployments, blank for domains.
	{$WGCONSOLE_TLS:}

	encode gzip

	# Backend API — everything under /api/ goes to the Go service.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Everything else is the React SPA. try_files falls back to index.html
	# so client-side routes (TanStack Router) survive a hard refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
	}
}
