# WGCONSOLE_TLS_LINE: expands to "tls internal" for IP-only deployments
# (no domain — public CAs can't issue certificates for bare IPs). Empty
# for domain names, where Caddy's normal ACME flow obtains public certs.
# WGCONSOLE_BIND_LINE: "bind 0.0.0.0" in IP-only mode — with an IP site
# address Caddy would bind that specific IP, which doesn't exist inside
# the container; binding all interfaces keeps the published ports working.
{$CONSOLE_DOMAIN} {
	{$WGCONSOLE_TLS_LINE:}
	{$WGCONSOLE_BIND_LINE:}

	encode gzip

	# Backend API — everything under /api/ goes to the Go service.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Everything else is the React SPA. try_files falls back to index.html
	# so client-side routes (TanStack Router) survive a hard refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
	}
}
