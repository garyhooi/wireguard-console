# IP-only mode: no domain, so public CAs can't issue a certificate.
# Caddy uses its internal CA instead, and binds all interfaces because
# the site's IP address is the host's, not the container's.
#
# Clients do NOT send SNI when connecting to a raw IP, so Caddy would
# match by the connection's destination IP (which inside the container is
# 172.x/192.168.x, not the public IP) and find no certificate — handshake
# dies with 'tlsv1 alert internal error'. default_sni pins the lookup to
# the console address (see caddyserver/caddy#6364).
{
	default_sni {$CONSOLE_DOMAIN}
}

{$CONSOLE_DOMAIN} {
	tls internal
	bind 0.0.0.0

	encode gzip

	# Backend API — everything under /api/ goes to the Go service.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Everything else is the React SPA. try_files falls back to index.html
	# so client-side routes (TanStack Router) survive a hard refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
	}
}

# Catch-all: any host that is not the console domain (e.g. a blocked
# domain resolved by AdGuard to this server) shows the branded block page.
#
# Plain HTTP first — browsers hitting a blocked site that isn't forced to
# HTTPS get the page directly.
http://:80 {
	root * /srv
	handle {
		rewrite * /blocked.html
		file_server
	}
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
	}
}

# HTTPS: browsers force HTTPS for most blocked domains, so also answer :443
# for any hostname. On-demand TLS issues an internal (self-signed)
# certificate the first time a blocked domain is requested, then the branded
# block page is served. The browser shows a one-time certificate warning,
# then renders the page. HSTS-preloaded domains (google.com etc.) may refuse
# to proceed past the warning — the DNS block still stops the connection.
:443 {
	tls {
		on_demand
		issuer internal
	}
	root * /srv
	handle {
		rewrite * /blocked.html
		file_server
	}
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
	}
}
