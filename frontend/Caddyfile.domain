# Domain mode (default): Caddy obtains public ACME certificates.
{$CONSOLE_DOMAIN} {
	encode gzip

	# Backend API — everything under /api/ goes to the Go service.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Everything else is the React SPA. try_files falls back to index.html
	# so client-side routes (TanStack Router) survive a hard refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
	}
}

# Catch-all: any host that is not the console domain (e.g. a blocked
# domain resolved by AdGuard to this server) shows the branded block page.
# Served over plain HTTP — browsers hitting a blocked site get the page
# instead of a connection error. HTTPS for arbitrary blocked domains can't
# work (no valid cert), but the DNS block still stops the connection.
http://:80 {
	root * /srv
	handle {
		rewrite * /blocked.html
		file_server
	}
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
	}
}