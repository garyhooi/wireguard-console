# Domain mode (default): Caddy obtains public ACME certificates.
{$CONSOLE_DOMAIN} {
	encode gzip

	# Backend API — everything under /api/ goes to the Go service.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Everything else is the React SPA. try_files falls back to index.html
	# so client-side routes (TanStack Router) survive a hard refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		# Consolidated security headers for the console SPA + API.
		# The Vite bundle ships external scripts/stylesheets (no inline
		# script), so script-src stays strict; React renders inline style
		# attributes (gauges/bars) → style-src 'unsafe-inline'; the TOTP QR
		# is a data: URL → img-src data:. API is same-origin only.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

# Catch-all: any host that is not the console domain (e.g. a blocked
# domain resolved by AdGuard to this server) shows the branded block page.
#
# Plain HTTP first — browsers hitting a blocked site that isn't forced to
# HTTPS get the page directly.
http://:80 {
	root * /srv
	handle {
		rewrite * /blocked.html
		file_server
	}
	header {
		# The block page has no user content and its only script is the
		# external /blocked-hostname.js, so keep it strict. It carries an
		# inline <style> → style-src 'unsafe-inline'.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
	}
}

# HTTPS: browsers force HTTPS for most blocked domains, so also answer :443
# for any hostname. On-demand TLS issues an internal (self-signed)
# certificate the first time a blocked domain is requested, then the branded
# block page is served. The browser shows a one-time certificate warning,
# then renders the page. HSTS-preloaded domains (google.com etc.) may refuse
# to proceed past the warning — the DNS block still stops the connection.
:443 {
	tls {
		on_demand
		issuer internal
	}
	root * /srv
	handle {
		rewrite * /blocked.html
		file_server
	}
	header {
		# The block page has no user content and its only script is the
		# external /blocked-hostname.js, so keep it strict. It carries an
		# inline <style> → style-src 'unsafe-inline'.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
	}
}
